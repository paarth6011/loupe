# Copy to .env for local Docker Compose. Compose reads this automatically.

# Postgres
POSTGRES_USER=cloudops
POSTGRES_PASSWORD=cloudops
POSTGRES_DB=cloudops

# Backend
# Inside the compose network the DB host is the service name "db".
DATABASE_URL=postgresql+psycopg://cloudops:cloudops@db:5432/cloudops
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seed/login user for the single-role MVP
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
