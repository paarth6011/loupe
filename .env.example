# Copy to .env for local Docker Compose. Compose reads this automatically.

# Postgres
POSTGRES_USER=cloudops
POSTGRES_PASSWORD=cloudops
POSTGRES_DB=cloudops

# Backend
# Inside the compose network the DB host is the service name "db".
DATABASE_URL=postgresql+psycopg://cloudops:cloudops@db:5432/cloudops
REDIS_URL=redis://redis:6379/0

# "dev" allows insecure defaults; set to "production" to refuse them at startup.
ENVIRONMENT=dev
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seed/login user for the single-role MVP
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Comma-separated CORS origins (frontend URL in prod)
CORS_ORIGINS=http://localhost:5173

# Alert notifications (Slack/Discord/generic webhook URL); empty = disabled
NOTIFY_WEBHOOK_URL=

# LLM-tuned alert thresholds (defaults shown; dormant for HTTP workloads)
COST_PER_REQUEST_THRESHOLD_USD=1.0
TOKEN_PER_REQUEST_THRESHOLD=100000
RATE_LIMIT_THRESHOLD=0.2

# Statistical anomaly detection (per-workload rolling z-score)
ANOMALY_Z_THRESHOLD=3.0
ANOMALY_RECENT_SAMPLES=5
ANOMALY_MIN_BASELINE=20
ANOMALY_BASELINE_WINDOW=100

# Data retention. 0 = keep forever. When > 0, samples (and stale resolved alerts)
# older than RETENTION_DAYS are pruned by a sweep every RETENTION_SWEEP_HOURS.
RETENTION_DAYS=0
RETENTION_SWEEP_HOURS=24
