# Production env for docker-compose.prod.yml. Copy to .env on the VM and fill in.
# (.env is gitignored — never commit real secrets.)

# --- Public address (your free DuckDNS subdomain) ---
# PUBLIC_URL is the full https URL (no trailing slash); PUBLIC_DOMAIN is the bare host.
PUBLIC_URL=https://YOUR-SUBDOMAIN.duckdns.org
PUBLIC_DOMAIN=YOUR-SUBDOMAIN.duckdns.org

# --- Required secrets ---
# The backend REFUSES to boot in production on default/empty values, so set real ones.
# Generate strong values, e.g.:  openssl rand -hex 32
POSTGRES_PASSWORD=change-me-long-random
JWT_SECRET=change-me-48-random-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong

# --- Multi-tenant isolation (set this to enforce Postgres row-level security) ---
# When set, the app serves as a NON-superuser role (loupe_app) so RLS actually
# binds — superusers bypass it. Migrations still run as POSTGRES_USER above. The
# role is created/granted automatically on boot. Leave EMPTY for a single-tenant
# self-host instance (the owner connection is used, and RLS bypass is harmless
# with only one tenant). Required before opening signups to multiple tenants.
APP_DB_PASSWORD=
# APP_DB_USER=loupe_app  # override the role name if you like

# --- Supabase end-user auth (Phase 2 — hosted SaaS sign-up) ---
# Set SUPABASE_URL (your project URL, https://<ref>.supabase.co) so the backend
# verifies end-user tokens against the project's JWKS — this is the modern
# Supabase default (asymmetric ES256). Use SUPABASE_JWT_SECRET only if your
# project still signs with the legacy shared HS256 secret. Leave BOTH empty for
# a single-tenant self-host instance (built-in admin login). See
# docs/phase2-setup.md.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Allowed CORS origins (comma-separated). Leave empty for a same-origin self-host
# instance (defaults to PUBLIC_URL). Set this when the frontend is hosted
# SEPARATELY (e.g. a Vercel SaaS deploy) so the browser can call this API:
#   CORS_ORIGINS=https://YOUR-SUBDOMAIN.duckdns.org,https://your-app.vercel.app
CORS_ORIGINS=
# To also run THIS self-host frontend build in Supabase mode (rare — the SaaS
# frontend is built on Vercel), set both; leave empty to keep the admin login.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# --- Optional: AI incident summaries (else the $0 deterministic template) ---
SUMMARY_PROVIDER=auto
ANTHROPIC_API_KEY=

# --- Optional: Slack/Discord webhook pinged on alerts ---
NOTIFY_WEBHOOK_URL=
