# Frontend build-time config. Vite inlines every VITE_* var at BUILD time, so
# these must be set when running `npm run build` (or as Docker build args /
# Vercel project env vars), not at container runtime. Copy to .env.local for
# local dev.

# Backend API base URL. Defaults to http://localhost:8000 if unset.
VITE_API_URL=http://localhost:8000

# --- Supabase end-user auth (hosted SaaS only) ---
# Set BOTH to switch the app into Supabase mode (email/password sign-up + sign-in
# for real end users). Leave BOTH empty for self-host, which keeps the built-in
# single-admin login. The anon key is public and safe to ship in the bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
