# Rendered by the nginx image's envsubst at startup ($PORT -> 8080 by default).
# $uri is left untouched because there is no `uri` env var to substitute.
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA: fall back to index.html for client-side routes.
    location / {
        try_files $uri /index.html;
    }
}
