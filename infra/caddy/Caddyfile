# Reverse proxy + automatic HTTPS for the single-host deploy.
# PUBLIC_DOMAIN comes from the environment (set in .env, passed by compose).
# On first start Caddy obtains a Let's Encrypt cert for this domain over HTTP-01,
# so ports 80 AND 443 must be reachable from the internet.

# Security headers applied at the edge (Caddy is the only internet-facing hop, so
# this covers both the SPA and the API without duplicating headers downstream).
# HSTS isn't added by Caddy automatically; the rest harden clickjacking, MIME
# sniffing, referrer leakage, and feature access. CSP is set per-site below.
(sec_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

{$PUBLIC_DOMAIN} {
	import sec_headers
	# SPA CSP: the Vite build has no inline scripts, so script-src 'self' blocks
	# injected scripts; styles allow inline (charts) + Google Fonts; connect-src
	# 'self' covers the same-origin /api, plus any https backend a self-hoster
	# points at. object/base/frame-ancestors are locked down.
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self' https:"

	# API under /api/* → backend. handle_path strips the /api prefix, so the
	# backend sees its normal routes (/auth/login, /metrics, /events, …).
	handle_path /api/* {
		reverse_proxy backend:8080 {
			# Keep Server-Sent Events (/events live updates) flowing promptly.
			flush_interval -1
		}
	}

	# Everything else → the static SPA (nginx).
	handle {
		reverse_proxy frontend:8080
	}
}

# Optional dedicated API subdomain (e.g. api.getloupe.net) for a SaaS deploy
# whose frontend is hosted elsewhere (Vercel). The WHOLE host is the API — the
# backend's routes are served at the root (/health, /auth/login, /events, …),
# so the SPA points VITE_API_URL straight at https://api.example.com (no /api).
# Caddy auto-issues a Let's Encrypt cert, so the DNS record must resolve to this
# box and NOT be proxied (Cloudflare grey-cloud / DNS-only).
#
# When API_DOMAIN is unset (the normal self-host case) this falls back to an
# internal-only address that never receives public traffic — keeping the block
# valid without issuing a real cert.
{$API_DOMAIN:localhost:8081} {
	import sec_headers
	# API-only host: responses are JSON, never a document, so lock the CSP all the
	# way down (a strict policy is harmless on non-HTML and adds defense in depth).
	header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	reverse_proxy backend:8080 {
		flush_interval -1
	}
}
